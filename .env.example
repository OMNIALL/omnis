# Copy to .env.local (and set the same vars on your host)

# Admin portal (/admin) - HTTP Basic Auth. Admin is disabled if ADMIN_PASSWORD is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Ad pixels - leave empty to disable
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Orders storage - Google Sheets (see docs/google-sheets-orders.md).
# Without these, orders go to src/data/orders.json (local dev only - lost on Vercel).
ORDERS_SHEET_URL=
ORDERS_SHEET_SECRET=
